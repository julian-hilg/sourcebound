%% sbresults.sty -- numbers in the text come from the analysis, never by hand.
%%
%%   \usepackage{sbresults}
%%   \sbresults{../../results/results.tex}   % generated by sourcebound.results
%%   ... the excess kurtosis is \result{h1.kurtosis} ...
%%   \result*{h1.vol}                         % value + unit, e.g. 0.6 % per day
%%
%% results.tex contains lines  \sbsetresult{key}{display}[unit]
%% A missing key prints a bold ?? and a warning (and `sb check` reports it).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbresults}[2026/11/09 v1.0 Sourcebound -- recorded results]

\ExplSyntaxOn
\prop_new:N \g__sbres_value_prop
\prop_new:N \g__sbres_unit_prop
\msg_new:nnn { sbresults } { missing } { Result~'#1'~is~not~recorded~(run~the~analysis). }
\msg_new:nnn { sbresults } { nofile }  { Results~file~'#1'~not~found~(run~the~analysis~first). }

\NewDocumentCommand \sbsetresult { m m o }
  {
    \prop_gput:Nnn \g__sbres_value_prop {#1} {#2}
    \IfValueT {#3} { \prop_gput:Nnn \g__sbres_unit_prop {#1} {#3} }
  }

\NewDocumentCommand \result { s m }
  {
    \prop_get:NnNTF \g__sbres_value_prop {#2} \l_tmpa_tl
      {
        \tl_use:N \l_tmpa_tl
        \IfBooleanT {#1}
          { \prop_get:NnNT \g__sbres_unit_prop {#2} \l_tmpb_tl { \nobreakspace \tl_use:N \l_tmpb_tl } }
      }
      { \textbf{??} \msg_warning:nnn { sbresults } { missing } {#2} }
  }

\NewDocumentCommand \sbresults { m }
  { \file_if_exist_input:nF {#1} { \msg_warning:nnn { sbresults } { nofile } {#1} } }
\ExplSyntaxOff
\endinput
