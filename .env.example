# Copy to .env (never commit .env). Only needed for remote storage / Postgres.
# Lake location overrides (otherwise hub.toml)
# SB_LAKE_ROOT=/Volumes/ResearchSSD/research-lake
# SB_CATALOG=postgres:dbname=lake host=localhost user=lake password=lake
# SB_DATA_PATH=s3://research-lake/data/
# Object storage (Cloudflare R2 is S3-compatible)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Zenodo publishing token (deposit:write)
# ZENODO_TOKEN=
