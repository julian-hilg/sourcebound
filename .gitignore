# The repository tracks the framework, its plugins, the frontend and the project template.
# Your own project folders are separate repositories (or private) and stay untracked.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.claude/
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/INSTALL.md
!/DEVELOPMENT.md
!/LICENSE
!/CITATION.cff
!/Makefile
!/hub.toml
!/pyproject.toml
!/uv.lock
!/compose.yaml
!/.env.example
!/src/
!/contracts/
!/datasources/
!/pipelines/
!/docs/
!/templates/
!/skills/
!/latex/
!/tests/
!/frontend/
!/designs/
!/plugins/
.claude/settings.local.json
.claude/agent-memory/
.claude/agent-memory-local/
__pycache__/
*.egg-info/
*.pyc
.env
.venv/
.DS_Store
# Pipelines, contracts and source entries of your own work stay out of this repository: only the
# ECB example is tracked. Real ones live in the registry of the data root, a private folder or the
# project they belong to.
pipelines/*
!pipelines/ecb_fx/
contracts/*
!contracts/market/
contracts/market/*
!contracts/market/ecb_fx_daily.yaml
datasources/*
!datasources/ecb_data_portal.yaml
templates/project/results/*
templates/project/tables/*
templates/project/figures/*.pdf
templates/project/deliverables/*.pdf

# the Werkbank bridge keeps conversations, workspaces and settings here (per machine, private)
.werkbank/
