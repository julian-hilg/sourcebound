# The repository tracks the framework, its plugins, the frontend and the project template.
# Your own project folders are separate repositories (or private) and stay untracked.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.claude/
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/INSTALL.md
!/DEVELOPMENT.md
!/LICENSE
!/CITATION.cff
!/Makefile
!/hub.toml
!/pyproject.toml
!/uv.lock
!/compose.yaml
!/.env.example
!/src/
!/contracts/
!/datasources/
!/pipelines/
!/docs/
!/templates/
!/skills/
!/latex/
!/tests/
!/frontend/
!/designs/
!/plugins/
.claude/settings.local.json
.claude/agent-memory/
.claude/agent-memory-local/
__pycache__/
*.egg-info/
*.pyc
.env
.venv/
.DS_Store
templates/project/results/*
templates/project/tables/*
templates/project/figures/*.pdf
templates/project/deliverables/*.pdf
